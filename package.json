{
  "name": "familysearch-mcp-secure",
  "version": "2.0.0",
  "description": "A local, read-only FamilySearch MCP server using OAuth Authorization Code with PKCE.",
  "private": true,
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "familysearch-mcp-secure": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./build/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "familysearch",
    "genealogy",
    "mcp",
    "oauth",
    "pkce"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
